{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": [
        "--python",
        "3.11",
        "mcp-for-blender"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "BLENDER_MCP_SAFE_MODE": "1",
        "UV_PYTHON_PREFERENCE": "only-managed"
      }
    }
  }
}
