diff --git a/evan-engine/test_rounded_cartoon_head.py b/evan-engine/test_rounded_cartoon_head.py
index b152f10..eb22690 100644
--- a/evan-engine/test_rounded_cartoon_head.py
+++ b/evan-engine/test_rounded_cartoon_head.py
@@ -37,0 +38,10 @@ class RoundingTests(unittest.TestCase):
+    def test_shape_context_keeps_neighbor_vowel_without_changing_contact_driver(self):
+        p=plan();p['fallbackCues']=[]
+        p['gestures'].append(dict(start=.17,end=.25,phone='P',value='A'))
+        before=copy.deepcopy(p);contact=acoustic_weights(.2,p,[])
+        context=acoustic_weights(.2,p,[],energy_weighting=False,contact_weighting=False)
+        self.assertGreater(contact[1],.99);self.assertGreater(context[6],.2)
+        self.assertAlmostEqual(context.sum(),1);self.assertGreaterEqual(context.min(),0)
+        np.testing.assert_array_equal(acoustic_weights(.2,p,[]),contact);self.assertEqual(p,before)
+        p['silences']=[dict(start=0,end=.8)]
+        np.testing.assert_allclose(acoustic_weights(.2,p,[],contact_weighting=False),np.eye(9)[0],atol=1e-8)
diff --git a/evan-engine/test_separated_oral.py b/evan-engine/test_separated_oral.py
index 1da07ea..1b135e1 100644
--- a/evan-engine/test_separated_oral.py
+++ b/evan-engine/test_separated_oral.py
@@ -23,0 +24,11 @@ class SeparatedOralTests(unittest.TestCase):
+ def test_rounded_bilabial_seal_stays_closed_without_forced_widening(self):
+  from current_contact_exposure import CurrentContactHead
+  from separated_oral_review import MaterialCapture
+  old=CurrentContactHead();new=MaterialCapture();seal=np.eye(9)[1];rounded=.5*seal+.5*np.eye(9)[6]
+  before=np.array(old.weights(seal,shape_weights=rounded,geometry_weights=seal));after=np.array(new.weights(seal,shape_weights=rounded,geometry_weights=seal))
+  self.assertLess(new.current_oral[0,0]-new.current_oral[8,0],old.current_oral[0,0]-old.current_oral[8,0])
+  self.assertLessEqual(float(new.current_oral[20,1]-new.current_oral[28,1]),.151)
+  np.testing.assert_array_equal(before[:288],after[:288])
+  # Full F/V retains the previous contact geometry even beside a rounded vowel.
+  contact=np.eye(9)[7];old.weights(contact,shape_weights=rounded,geometry_weights=contact);new.weights(contact,shape_weights=rounded,geometry_weights=contact)
+  np.testing.assert_array_equal(new.current_oral,old.current_oral)
