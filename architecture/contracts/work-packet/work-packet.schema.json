{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TeamRovor/rovor-video-engine/blob/main/architecture/contracts/work-packet/work-packet.schema.json",
  "title": "ROVOR portable work packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "capability",
    "intent",
    "source_refs",
    "constraints",
    "acceptance",
    "executor",
    "authorization",
    "technical_status",
    "artifact_receipt",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"
    },
    "capability": {
      "enum": [
        "client_intake",
        "sourced_sales",
        "ci_triage",
        "software_delivery",
        "video_production",
        "research"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/acceptance"
      }
    },
    "executor": {
      "$ref": "#/$defs/executor"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "technical_status": {
      "enum": [
        "not_run",
        "running",
        "passed",
        "failed",
        "unknown",
        "blocked"
      ]
    },
    "artifact_receipt": {
      "$ref": "#/$defs/artifactReceipt"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "status",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,119}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "status": {
          "enum": [
            "verified",
            "unverified",
            "unavailable"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classification",
        "allowed_effects",
        "prohibited_effects"
      ],
      "properties": {
        "data_classification": {
          "enum": [
            "public_only",
            "synthetic",
            "confidential",
            "restricted"
          ]
        },
        "allowed_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "prohibited_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "effect": {
      "enum": [
        "read_public_source",
        "write_repository_branch",
        "run_hosted_tests",
        "modify_local_project",
        "contact_external",
        "spend_money",
        "publish",
        "deploy"
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "enum": [
            "not_run",
            "running",
            "pass",
            "fail",
            "unknown",
            "blocked"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requires",
        "mode"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "hosted_ci",
            "local_runtime",
            "remote_service"
          ]
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "repository_read",
              "repository_write",
              "hosted_ci",
              "local_runtime",
              "original_assets",
              "human_approval",
              "browser"
            ]
          }
        },
        "mode": {
          "enum": [
            "bounded_read_only",
            "draft_only",
            "authorized_write",
            "visual_review"
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "effects",
        "source_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "granted",
            "denied"
          ]
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "artifacts"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_created",
            "reserved",
            "produced",
            "verified",
            "failed",
            "unknown"
          ]
        },
        "artifacts": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "status",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,119}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "status": {
          "enum": [
            "verified",
            "unverified",
            "unavailable"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "pending_review",
            "approved",
            "rejected",
            "published",
            "delivered"
          ]
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
